{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"Project doc-currency policy: docs/ROADMAP.md is the living backlog \u2014 skim it at session start. Before ending any session that changed game code or design, update docs/ROADMAP.md and any affected docs (CLAUDE.md, .claude/rules/*, research/*, README.md). A Stop hook enforces this once per session.\"}}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/theme-authoring-hook.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/impacted-manifest-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/wiki-context-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/docs-currency-hook.sh\"",
            "timeout": 10,
            "statusMessage": "Checking doc currency..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/wiki-freshness-hook.sh\"",
            "timeout": 30,
            "statusMessage": "Checking knowledge graph health..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/journal-hook.sh\"",
            "timeout": 10,
            "statusMessage": "Checking shared-learning journal..."
          }
        ]
      }
    ]
  }
}
